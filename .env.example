# When a custom domain ships, set Production to that origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OPS_PHONE=

# Supabase (leads data only; not ops login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
# Interim until a Mena Estates domain is verified in Resend.
RESEND_FROM=Mena Estates <onboarding@resend.dev>
LEAD_ALERT_TO=parsorq@gmail.com
# Mena contact for under_contract handoff notice (Prompt C)
MENA_HANDOFF_TO=

# Ops Google (Auth.js). parsorq@gmail.com is always allowlisted in code.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_TRUST_HOST=true
OPS_OPERATOR_EMAILS=

# Consent trail
CONSENT_TEXT_VERSION=2026-11-09-v1

